[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3

# Systemd OOM-Schutz: Verhindert Systemabsturz bei Speicherüberlauf
MemoryMax=56G
OOMScoreAdjust=500

# Pfade & Netzwerkeinstellungen
Environment="OLLAMA_MODELS=/home/models"
Environment="OLLAMA_HOST=0.0.0.0:11434"

# VRAM & Performance-Optimierung für AMD Radeon Pro W7800 (48GB VRAM)
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_GPU_OVERHEAD=4294967296"
Environment="OLLAMA_KV_CACHE_TYPE=q4_0"
Environment="OLLAMA_CONTEXT_LENGTH=16384"
Environment="OLLAMA_KEEP_ALIVE=24h"

[Install]
WantedBy=default.target
