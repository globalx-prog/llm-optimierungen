FROM hf.co/bartowski/Qwen2.5-72B-Instruct-GGUF:IQ4_XS

# 100% VRAM (Alle 80 Layer auf AMD Radeon Pro W7800)
# Modellgröße: ~39.7 GB -> passt komplett in VRAM -> max. Speed (~40-44 t/s)
PARAMETER num_gpu 999

# Kontext & Batching (32k passt zu 100% in VRAM)
PARAMETER num_ctx 32768
PARAMETER num_batch 2048
PARAMETER num_predict 8192

# Sampling-Parameter für präzisen Code & Tool Use
PARAMETER temperature 0.3
PARAMETER top_p 0.8
PARAMETER repeat_penalty 1.05
